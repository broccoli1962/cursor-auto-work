# ─────────────────────────────────────────────────────────────
# Unity & Cursor Headless CLI Orchestrator - 환경 변수 예시
# 이 파일을 복사해 `.env` 로 저장한 뒤 값을 채우세요.
# ─────────────────────────────────────────────────────────────

# [필수] 오케스트레이터가 작업할 Unity 프로젝트 루트 경로
# (Assets/, ProjectSettings/ 가 존재하는 폴더)
TARGET_PROJECT_PATH=D:\UnityProjects\MyGame

# [batch 채널일 때만 필수] Unity Editor 실행 파일 경로
# 기본 검수는 열린 에디터 + UnityMCP 이므로 compile/full 에도 보통 필요 없습니다.
UNITY_PATH=C:\Program Files\Unity\Hub\Editor\2022.3.40f1\Editor\Unity.exe

# [선택] compile/full 검수 채널
#   mcp   : 열린 Unity Editor 에 UnityMCP 로 컴파일/테스트 (기본값, 에디터를 끄지 않음)
#   batch : Unity.exe -batchmode -quit (에디터/MCP 가 끊김. CI 전용)
UNITY_VALIDATION_BACKEND=mcp

# [선택] 인스턴스가 없으면 UNITY_PATH 로 에디터를 띄운 뒤 대기 (기본 true)
UNITY_LAUNCH_EDITOR=true
UNITY_LAUNCH_TIMEOUT_MS=180000

# [선택] 검수 전 Play Mode 중지 / 검수 후 복구
UNITY_STOP_PLAY_MODE=true
UNITY_RESTORE_PLAY_MODE=true

# [선택] Cursor Headless CLI 실행 명령 (PATH 등록 시 그대로 두면 됨)
CURSOR_AGENT_BIN=agent

# [선택] Cursor Agent 에게 사용할 모델
CURSOR_MODEL=

# [선택] MCP / 파일쓰기 자동 승인 플래그 (기본 true — 무인 실행용)
# true 이면 --force 를 붙여 파일 쓰기와 MCP 도구 호출을 사람 확인 없이 승인합니다.
# 사람 승인이 필요하면 false.
CURSOR_YOLO=true

# [선택] 프롬프트를 agent CLI 에 전달하는 방식
#   auto  : 명령행에 안전하게 실릴 때만 인자로, 그 외에는 stdin 으로 전달 (기본값/권장)
#   argv  : 항상 명령행 인자로 전달 (Windows cmd.exe 는 8191자 상한 + 줄바꿈 불가)
#   stdin : 항상 표준 입력으로 전달
#   file  : 프롬프트를 runtime/prompts 에 저장하고 그 경로를 읽으라고 지시
CURSOR_PROMPT_DELIVERY=auto

# [선택] Discord Webhook URL (미설정 시 알림은 콘솔 로그로만 출력)
DISCORD_WEBHOOK_URL=

# [선택] 기획서 / 로드맵 경로 (TARGET_PROJECT_PATH 기준 상대경로 허용)
SPEC_PATH=./docs/spec.md
ROADMAP_PATH=./docs/roadmap.json

# [선택] 상태 파일 및 런타임 산출물 경로
STATE_PATH=./runtime/state.json
RUNTIME_DIR=./runtime

# [선택] Step 당 최대 재시도 횟수
MAX_RETRIES=3

# [선택] Cursor Agent 1회 실행 타임아웃 (ms) - 기본 30분
AGENT_TIMEOUT_MS=1800000

# [선택] Unity 검수 1회 타임아웃 (ms) - 기본 20분 (MCP 대기/배치모드 공통)
UNITY_TIMEOUT_MS=1200000

# [선택] 검수 파이프라인 프리셋
#   lint    : Git Diff + 컨벤션 린트 (에디터 없이 실행)
#   compile : lint + 열린 Unity Editor(MCP) 컴파일 (기본값, 에디터를 켜 둘 것)
#   full    : lint + 에디터 컴파일 + EditMode 테스트 (roadmap step.runTests=true 일 때만)
#   skip    : 검수 생략 (diff 수집만, 실패·재시도 없음)
VALIDATION_MODE=compile

# [선택] targetFiles / 완료 조건 문장에서 파일 존재 검사를 추론 (로드맵 파일은 고치지 않음)
INFER_VERIFY=true

# [선택] 기계 체크·컴파일 통과 후 완료 조건 판정 Agent (쓰기/--force 없음, --trust 는 붙음)
# AGENT_TIMEOUT_MS 와 별개. 조건이 많으면 600000(10분) 권장
STEP_JUDGE=true
JUDGE_TIMEOUT_MS=180000

# [선택] 검수 실패 재시도 시 직전 Agent 세션 resume
RESUME_ON_RETRY=true

# [선택] 재시도 한도 초과 시 이번 Step 변경만 롤백 (시작 당시 dirty 는 유지)
ROLLBACK_ON_FAIL=true

# [선택] run 시작 시 auto-work/* 작업 브랜치 생성
CREATE_WORK_BRANCH=true

# [선택] 규칙/기획서 프롬프트 예산 (초과 시 중간 생략 + 경고)
RULES_MAX_CHARS=40000
SPEC_MAX_CHARS=20000

# [선택] 검수 통과 시 자동 커밋 여부
AUTO_COMMIT=false

# [선택] 커밋 성공 후 origin 푸시 (force 없음)
AUTO_PUSH=false

# [선택] 커밋 메시지 언어: ko | en  (형식은 항상 {영역} - {변경})
COMMIT_LANGUAGE=ko

# [선택] 자동 커밋 시 사용할 작성자 정보 (미설정 시 로컬 git config 사용)
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

# [선택] 실패 프롬프트에 포함할 컴파일 에러 최대 라인 수
MAX_ERROR_LINES=30

# [선택] 로그 레벨: debug | info | warn | error
LOG_LEVEL=info

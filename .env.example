# ─────────────────────────────────────────────────────────────
# Unity & Cursor Headless CLI Orchestrator - 환경 변수 예시
# 이 파일을 복사해 `.env` 로 저장한 뒤 값을 채우세요.
# ─────────────────────────────────────────────────────────────

# [필수] 오케스트레이터가 작업할 Unity 프로젝트 루트 경로
# (Assets/, ProjectSettings/ 가 존재하는 폴더)
TARGET_PROJECT_PATH=D:\UnityProjects\MyGame

# [필수] Unity Editor 실행 파일 경로
UNITY_PATH=C:\Program Files\Unity\Hub\Editor\2022.3.40f1\Editor\Unity.exe

# [선택] Cursor Headless CLI 실행 명령 (PATH 등록 시 그대로 두면 됨)
CURSOR_AGENT_BIN=cursor-agent

# [선택] Cursor Agent 에게 사용할 모델
CURSOR_MODEL=

# [선택] MCP / 파일쓰기 자동 승인 플래그 (UnityMCP 자율 조작에 필요)
# true 이면 --force 옵션을 붙여 모든 도구 호출을 자동 승인합니다.
CURSOR_YOLO=true

# [선택] Discord Webhook URL (미설정 시 알림은 콘솔 로그로만 출력)
DISCORD_WEBHOOK_URL=

# [선택] 기획서 / 로드맵 경로 (TARGET_PROJECT_PATH 기준 상대경로 허용)
SPEC_PATH=./docs/spec.md
ROADMAP_PATH=./docs/roadmap.json

# [선택] 상태 파일 및 런타임 산출물 경로
STATE_PATH=./runtime/state.json
RUNTIME_DIR=./runtime

# [선택] Step 당 최대 재시도 횟수
MAX_RETRIES=3

# [선택] Cursor Agent 1회 실행 타임아웃 (ms) - 기본 30분
AGENT_TIMEOUT_MS=1800000

# [선택] Unity Batchmode 1회 실행 타임아웃 (ms) - 기본 20분
UNITY_TIMEOUT_MS=1200000

# [선택] Unity EditMode 테스트 실행 여부 (roadmap step 에서 개별 override 가능)
RUN_UNITY_TESTS=false

# [선택] 검수 통과 시 자동 커밋 여부
AUTO_COMMIT=true

# [선택] 자동 커밋 시 사용할 작성자 정보 (미설정 시 로컬 git config 사용)
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

# [선택] 실패 프롬프트에 포함할 컴파일 에러 최대 라인 수
MAX_ERROR_LINES=30

# [선택] 로그 레벨: debug | info | warn | error
LOG_LEVEL=info

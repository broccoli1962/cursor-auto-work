# ─────────────────────────────────────────────────────────────
# Unity & Cursor Headless CLI Orchestrator
# 복사해 `.env` 로 저장한 뒤 필요한 값만 바꾸세요.
# 여기 적힌 값이 코드 기본값입니다. 지운 키도 같은 기본값으로 동작합니다.
# ─────────────────────────────────────────────────────────────

# [필수] 작업할 Unity 프로젝트 루트 (Assets/, ProjectSettings/)
TARGET_PROJECT_PATH=D:\UnityProjects\MyGame

# Unity.exe. batch 검수, 또는 unity open 실패 시 폴백. 비우면 사용하지 않음
UNITY_PATH=

# 공식 Unity CLI 실행 파일. PATH 에 있으면 unity
UNITY_CLI_BIN=unity

# CLI 가 없을 때: ask(터미널이면 질문) | yes(바로 설치) | no(안내만)
UNITY_CLI_INSTALL=ask

# com.unity.pipeline 이 없을 때: ask | yes | no. Unity 6.0 이상
UNITY_PIPELINE_INSTALL=ask

# 검수 채널. cli=열린 에디터. batch=에디터를 끄는 배치모드
UNITY_VALIDATION_BACKEND=cli

# 에디터가 없으면 unity open 으로 띄움
UNITY_LAUNCH_EDITOR=true
# 에디터 기동 대기 (ms). 기본 3분
UNITY_LAUNCH_TIMEOUT_MS=180000

# 컴파일 검수 전에 Play Mode 를 끌지. false 면 재생 중일 때 검수 실패
UNITY_STOP_PLAY_MODE=true
# 검수가 끝나면 원래 Play Mode 로 되돌릴지
UNITY_RESTORE_PLAY_MODE=true

# Cursor CLI 명령. PATH 에 있으면 agent
CURSOR_AGENT_BIN=agent
# 비우면 CLI 기본 모델
CURSOR_MODEL=

# true 면 구현 Agent 에 --force (파일 쓰기·셸 자동 승인)
CURSOR_YOLO=true

# 프롬프트 전달: auto | argv | stdin | file
CURSOR_PROMPT_DELIVERY=auto

# 비우면 Discord 알림 없이 콘솔만
DISCORD_WEBHOOK_URL=

# 기획서·로드맵·상태·런타임 경로 (프로젝트 기준 상대경로 가능)
SPEC_PATH=./docs/spec.md
ROADMAP_PATH=./docs/roadmap.json
STATE_PATH=./runtime/state.json
RUNTIME_DIR=./runtime

# Step 하나당 재시도 횟수
MAX_RETRIES=3
# 구현 Agent 1회 제한 (ms). 기본 30분
AGENT_TIMEOUT_MS=1800000
# Unity 컴파일·테스트 1회 제한 (ms). 기본 20분
UNITY_TIMEOUT_MS=1200000

# 검수: lint | compile | full | skip
VALIDATION_MODE=compile
# targetFiles·완료 조건에서 파일 검사 추론
INFER_VERIFY=true
# 완료 조건 판정 Agent (읽기 전용)
STEP_JUDGE=true
# 판정 Agent 제한 (ms). 기본 3분. 조건이 많으면 600000
JUDGE_TIMEOUT_MS=180000

# 기획 → 개발 → 검토 → 기획 수정. false 면 로드맵만 실행
AUTONOMY=true
# 그 루프의 시간 예산 (ms). 기본 4시간. 끝나면 paused, 다음 run 이 이어서 진행
AUTONOMY_BUDGET_MS=14400000
# 사이클 안전 상한
AUTONOMY_MAX_CYCLES=48
# 검토 사이에 실행할 Step 수. 1이면 매 Step 뒤 측정을 다시 봄
AUTONOMY_STEPS_PER_CYCLE=1
# playtest.probe 를 Play Mode 에서 읽음. compile/full + Unity CLI 일 때
AUTONOMY_PLAYTEST=true
# 재생 후, 그리고 조작 후 캡처 전 대기 (ms)
AUTONOMY_PLAYTEST_SETTLE_MS=2000
# probe 가 어긋나면 그 자리에서 고치고 다시 조작하는 횟수
AUTONOMY_PLAYTEST_RETRIES=3
# 목표 대비 검토 Agent 제한 (ms). 기본 10분
AUTONOMY_REVIEW_TIMEOUT_MS=600000

# 개발 주제. 비우면 기획서를 목표로 두고 기존 로드맵을 유지
GOAL=
# GOAL 이 비어 있을 때 읽을 주제 파일. 없으면 무시
GOAL_PATH=./docs/goal.md

# 구현 세션을 Step 과 화면 확인 뒤로 이어 감. 검토는 항상 새 세션
AUTONOMY_RESUME_SESSION=true
# 이 Step 수 뒤 구현 세션만 새로 연다. 최근 검토 이유는 프롬프트에 남김
AUTONOMY_SESSION_STEPS=4
# 검수 실패로 같은 Step 을 다시 할 때 직전 세션 resume
RESUME_ON_RETRY=true

# 재시도 한도 초과 시 그 Step 이 만든 변경만 되돌림
ROLLBACK_ON_FAIL=true
# run 시작 시 auto-work/<시각> 브랜치 생성
CREATE_WORK_BRANCH=true

# 프롬프트에 넣는 규칙·기획서 글자 예산
RULES_MAX_CHARS=40000
SPEC_MAX_CHARS=20000

# 검수 통과 시 커밋 / 그 다음 push (force 없음)
AUTO_COMMIT=false
AUTO_PUSH=false
# 커밋 메시지 언어. 형식은 항상 {영역} - {변경}
COMMIT_LANGUAGE=ko
# 비우면 로컬 git config 작성자
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

# 컴파일 실패 피드백에 넣을 에러 줄 수
MAX_ERROR_LINES=30
# debug | info | warn | error
LOG_LEVEL=info

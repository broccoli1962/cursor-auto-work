{
  "name": "cursor-auto-work",
  "version": "0.1.0",
  "description": "Unity & Cursor Headless CLI 기반 완전 자동화 오케스트레이터 (테스트 버전)",
  "type": "commonjs",
  "main": "dist/index.js",
  "bin": {
    "cursor-auto-work": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "run:orchestrator": "node dist/index.js run",
    "clean": "rimraf dist"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "fast-xml-parser": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
